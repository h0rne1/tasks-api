{
  "info": {
    "name": "Tasks API (CRUD + PostgreSQL)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "taskId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('taskId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Сдать контрольную\",\n  \"description\": \"Docker Compose + PostgreSQL\"\n}" },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "Get all tasks",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks" }
    },
    {
      "name": "Get task by id",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
    },
    {
      "name": "Update task",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Сдать контрольную\",\n  \"description\": \"Готово\",\n  \"isCompleted\": true\n}" },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "Delete task",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
    }
  ]
}
